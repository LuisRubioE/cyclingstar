# Copia este archivo a .env para desarrollo local. Nunca subas tu .env real.

# Base de datos Postgres. En Railway se conecta como variable de referencia del
# plugin Postgres del proyecto. En local, la de tu Postgres de desarrollo (SPEC 12).
DATABASE_URL=postgresql://usuario:password@localhost:5432/cyclingstar

# Token del endpoint protegido POST /admin/tick para desarrollo y recuperación manual
# (SPEC 12). Genera uno largo y aleatorio.
ADMIN_TOKEN=cambia-esto-por-un-token-largo-y-secreto

# Secreto de firma de sesiones (better-auth, Paso 9). Genera uno largo y aleatorio.
SESSION_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# URL pública de la app; better-auth la usa como baseURL y origen de confianza
# para las cookies de sesión (Paso 9). En local: http://localhost:3000
# OJO: tiene que ser el dominio CANÓNICO por el que se navega. better-auth rechaza con
# «Invalid origin» lo que venga de otro sitio, así que apuntarla mal tira el login.
APP_URL=https://www.cyclingstar.app

# Orígenes de confianza ADICIONALES, separados por comas. La pareja con y sin www de APP_URL ya se
# acepta sola; esto es para el dominio viejo mientras dura una migración, o un entorno de pruebas.
# EXTRA_TRUSTED_ORIGINS=https://cyclingstar.up.railway.app

# Correo del ADMINISTRADOR RAÍZ (opcional). La cuenta con este correo, una vez CONFIRMADO, entra en
# el panel /admin sin que nadie le dé el permiso; desde ahí puede hacer admin a otros.
# ADMIN_EMAIL=tu-correo@ejemplo.com

# Puerto de escucha. En local por defecto 3000; en Railway lo inyecta la plataforma.
PORT=3000

# Correo transaccional por Resend (recuperar contraseña, verificar el correo y confirmar su
# cambio). OPCIONALES, pero van en pareja: con una sola, la app no arranca. Sin ninguna, la app
# funciona y no manda correo (lo deja dicho en el log), que es lo normal en local.
# RESEND_API_KEY=re_...
# MAIL_FROM=Cycling Star <no-reply@cyclingstar.app>
