# Copia este archivo a .env para desarrollo local. Nunca subas tu .env real.

# Base de datos Postgres. En Railway se conecta como variable de referencia del
# plugin Postgres del proyecto. En local, la de tu Postgres de desarrollo (SPEC 12).
DATABASE_URL=postgresql://usuario:password@localhost:5432/cyclingstar

# Token del endpoint protegido POST /admin/tick para desarrollo y recuperación manual
# (SPEC 12). Genera uno largo y aleatorio.
ADMIN_TOKEN=cambia-esto-por-un-token-largo-y-secreto

# Secreto de firma de sesiones (better-auth, Paso 9). Genera uno largo y aleatorio.
SESSION_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Puerto de escucha. En local por defecto 3000; en Railway lo inyecta la plataforma.
PORT=3000
