{
  "name": "cyclingstar",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b && pnpm --filter @cyclingstar/web build",
    "typecheck": "tsc -b && pnpm --filter @cyclingstar/web typecheck",
    "clean": "tsc -b --clean",
    "sim": "pnpm --filter @cyclingstar/engine build && node packages/engine/dist/sim/cli.js",
    "sim:tactics": "pnpm --filter @cyclingstar/engine build && node packages/engine/dist/sim/tacticsCli.js",
    "sim:mundo": "pnpm --filter @cyclingstar/engine build && node packages/engine/dist/sim/worldCli.js",
    "sim:pareado": "pnpm --filter @cyclingstar/engine build && node packages/engine/dist/sim/pareado.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:rapido": "vitest run --exclude '**/node_modules/**' --exclude 'packages/engine/src/sim/**' --exclude 'packages/db/src/horizonLatency.test.ts' --exclude 'apps/web/src/domain/broadcast/clientCost.test.ts' --exclude 'apps/api/src/voicePrefix.test.ts'",
    "test:bancos": "vitest run packages/engine/src/sim/",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test:latencia": "vitest run --no-file-parallelism packages/db/src/horizonLatency.test.ts apps/web/src/domain/broadcast/clientCost.test.ts apps/api/src/voicePrefix.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
